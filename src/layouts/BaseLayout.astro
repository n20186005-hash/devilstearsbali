---
import '../styles/global.css';
import { SITE_NAME } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  robots?: string;
}

const {
  title,
  description,
  image = '/images/devils-tears-coast.webp',
  robots = 'index,follow,max-image-preview:large',
} = Astro.props;
const canonical = Astro.site && !robots.includes('noindex') ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a3838" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <link rel="sitemap" href={new URL('/sitemap-index.xml', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <slot />
    <script is:inline src="/consent.js"></script>
  </body>
</html>
