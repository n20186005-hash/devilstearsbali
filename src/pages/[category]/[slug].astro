---
import TopicPage from '../../components/TopicPage.astro';
import { TOPICS } from '../../data/topics';

export function getStaticPaths() {
  return TOPICS.map((t) => ({
    params: { category: t.category, slug: t.slug },
    props: { topic: t },
  }));
}

const { topic } = Astro.props;
---

<TopicPage topic={topic} />
