---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const mapLink = 'https://maps.app.goo.gl/V6nZFxGMZhUdAUtR9';
const attractionSchema = {"@context": "https://schema.org", "@type": "TouristAttraction", "name": "Devil's Tear, Nusa Lembongan", "alternateName": "Devil's Tears / Pantai Batu Belek", "description": "Tebing pesisir Nusa Lembongan yang disebut Pantai Batu Belek dalam arsip Pemerintah Kabupaten Klungkung.", "url": "https://devilstearsbali.com/", "address": {"@type": "PostalAddress", "streetAddress": "Nusa Lembongan", "addressLocality": "Jungutbatu", "addressRegion": "Bali", "postalCode": "80771", "addressCountry": "ID"}, "geo": {"@type": "GeoCoordinates", "latitude": -8.690565, "longitude": 115.4302884}, "hasMap": "https://maps.app.goo.gl/V6nZFxGMZhUdAUtR9"};
const faqs = [{"q": "Di mana Devil’s Tear atau Devil’s Tears?", "a": "Devil’s Tear berada di Nusa Lembongan, Kabupaten Klungkung, Bali. Arsip Pemerintah Klungkung menyebutnya Pantai Batu Belek. Cuplikan Google Maps 19 Oktober 2026 menampilkan Jungutbatu, Kecamatan Nusa Penida, Bali 80771."}, {"q": "Apakah Devil’s Tear dapat dikunjungi 24 jam?", "a": "Google Maps pada 19 Oktober 2026 mencantumkan 24 jam setiap hari. Itu cuplikan pihak ketiga, bukan jaminan akses, petugas, loket atau keamanan malam. Konfirmasikan akses sebelum berangkat dan patuhi penutupan setempat."}, {"q": "Berapa biaya masuk Devil’s Tear?", "a": "Laporan Pemerintah Klungkung 19 Agustus 2026 menyebut retribusi kawasan Nusa Lembongan–Nusa Ceningan untuk wisatawan mancanegara: Rp25.000 dewasa dan Rp15.000 anak usia 4–13 tahun, dengan penyesuaian pemungutan mulai 1 September 2026. Ini bukan konfirmasi tiket tunggal Devil’s Tear atau total biaya semua pengunjung; tanyakan kategori, cakupan, bukti pembayaran dan biaya lain sebelum membayar."}, {"q": "Kapan semburan ombak atau matahari terbenam bisa dipastikan?", "a": "Tidak ada jadwal atau kondisi yang kami jamin menghasilkan semburan, pelangi atau panorama tertentu. Jangan mengejar gelombang tinggi atau titik foto dekat tepi. Ikuti prakiraan resmi, rambu dan arahan petugas; batalkan bila akses ditutup atau kondisi memburuk."}, {"q": "Apakah boleh mendekat ke tepi atau masuk ke air?", "a": "Jangan melewati pagar, turun ke batu yang terkena ombak, atau masuk ke air untuk berfoto. Dinas Pariwisata Klungkung melaporkan pemeriksaan papan peringatan di Devil’s Tear pada 30 Agustus 2025. Laporan itu bukan penilaian bahwa kondisi saat ini aman."}, {"q": "Bagaimana merencanakan transportasi ke lokasi?", "a": "Konfirmasikan pelabuhan keberangkatan dan kedatangan, jadwal kapal, pembatalan karena cuaca, serta sambungan darat kepada penyedia transportasi. Pin peta adalah orientasi lokasi, bukan bukti jalur pejalan kaki atau titik turun yang dapat digunakan."}, {"q": "Apakah toilet, parkir dan akses kursi roda tersedia?", "a": "Arsip pemerintah membahas rencana fasilitas, tetapi bukan bukti layanan yang berfungsi sekarang. Konfirmasikan toilet, parkir, tarif, kondisi jalur serta aksesibilitas sebelum datang. Jangan menganggap seluruh jalur tebing bebas hambatan."}, {"q": "Apakah kunjungan mencakup tempat lain di Lembongan?", "a": "Jangan menganggap ada tiket, jalur langsung atau izin gabungan. Dream Beach dan mangrove muncul sebagai destinasi terpisah dalam laporan pemeriksaan papan peringatan 2025; periksa alamat, akses dan layanan masing-masing secara terpisah."}];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({q,a}) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title="Devil’s Tear Nusa Lembongan: Lokasi, Biaya & Kunjungan" description="Panduan independen Devil’s Tear di Nusa Lembongan: lokasi, cuplikan jam Maps, cakupan retribusi resmi, persiapan transportasi dan batas akses tebing." image="/images/devils-tears-coast.webp">
<SiteHeader /><main id="konten">
<section class="relative overflow-hidden bg-[#0a3838] text-white"><img src="/images/devils-tears-coast.webp" alt="Pesisir berbatu dan laut pada foto arsip Arnas Goldberg" width="1600" height="1059" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,31,31,.91),rgba(5,31,31,.58))]"></div><div class="section-shell relative py-24 lg:py-32"><div class="max-w-3xl"><p class="eyebrow !text-[#f0c272]">Panduan independen · bukan situs pengelola</p><h1 class="mt-6 font-[Georgia] text-[clamp(3.6rem,10vw,8rem)] leading-[.9] tracking-[-.045em]">Devil’s Tear<br /><span class="text-[#f0c272]">Nusa Lembongan</span></h1><p class="mt-8 max-w-2xl text-lg leading-8">Lanskap tebing dan deburan laut di Bali. Rencanakan akses dengan hati-hati, hormati pembatas, dan nikmati pemandangan tanpa mengejar semburan dari dekat.</p><div class="mt-8 flex flex-wrap gap-3"><a href="#kunjungan" class="rounded-full bg-[#f3ead8] px-6 py-3 font-bold text-[#102725]">Sebelum berkunjung</a><a href={mapLink} class="rounded-full border border-white/40 px-6 py-3 font-bold" target="_blank" rel="noreferrer">Buka peta ↗</a></div></div></div></section>
<p class="photo-note">Foto arsip 2015: <a href="https://commons.wikimedia.org/wiki/File:Devil_S_Tear_(132297245).jpeg">Arnas Goldberg / Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>. Ukuran diubah dan tampilan dipotong; bukan acuan ombak, pagar atau akses saat ini.</p>
<section class="bg-[#f3ead8] py-6"><div class="section-shell grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><div><b>Lokasi</b><p>Nusa Lembongan · Klungkung</p></div><div><b>Cuplikan Google Maps</b><p>4,6 / 5 · 7.267 ulasan</p></div><div><b>Diperiksa</b><p>19 Oktober 2026</p></div><div><b>Jam pada Maps</b><p>24 jam · akses perlu dikonfirmasi</p></div></div></section>
<section id="kenali" class="py-20"><div class="section-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Kenali tempatnya</p><h2 class="section-title mt-4">Devil’s Tear, juga dikenal sebagai Pantai Batu Belek.</h2></div><div class="prose-copy"><p>Arsip Pemerintah Kabupaten Klungkung menyebut deburan ombak yang menghempas tebing Pantai Batu Belek (Devil Tears) di Nusa Lembongan. Cuplikan Maps pada tanggal pemeriksaan tidak mencantumkan telepon atau situs pengelola. Situs ini merupakan panduan independen.</p><p>Foto dan laporan lama membantu mengenali bentang pesisir, tetapi tidak memastikan bentuk pagar, layanan atau kondisi laut hari ini. Tidak ada ukuran semburan, kondisi pasang, waktu kunjungan ideal atau durasi tetap yang dijanjikan.</p><p><a href="https://klungkungkab.go.id/berita/detail/devil-tears-mulai-dirilik-banyak-investor">Baca arsip Klungkung tentang Pantai Batu Belek</a>.</p></div></div></section>
<section class="pb-20"><div class="section-shell grid gap-6 lg:grid-cols-2"><figure class="overflow-hidden rounded-3xl bg-[#102725]"><img src="/images/devils-tears-hero.webp" alt="Percikan air dan batu pesisir pada foto arsip yang dikreditkan kepada Burmesedays" width="1600" height="1200" loading="lazy" class="w-full aspect-[4/3] object-cover" /><figcaption class="photo-note">Foto referensi arsip: <a href="https://commons.wikimedia.org/wiki/File:Devil%27s_Tear,_Nusa_Lembongan.jpg">Burmesedays / Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Halaman sumber mencatat impor Wikivoyage belum ditinjau; lokasi foto belum kami verifikasi secara mandiri. Ukuran diubah; bukan bukti kondisi sekarang.</figcaption></figure><figure class="overflow-hidden rounded-3xl bg-[#102725]"><img src="/images/devils-tears-landscape.webp" alt="Bentang laut dan batu pada foto referensi arsip Burmesedays" width="1600" height="1200" loading="lazy" class="w-full aspect-[4/3] object-cover" /><figcaption class="photo-note">Foto referensi arsip: <a href="https://commons.wikimedia.org/wiki/File:Devil%27s_Tear.jpg">Burmesedays / Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Metadata impor belum ditinjau di sumber; lokasi tidak dikonfirmasi mandiri. Ukuran diubah; tidak menunjukkan akses terkini.</figcaption></figure></div></section>
<section id="kunjungan" class="bg-[#0a3838] py-20 text-white"><div class="section-shell"><p class="eyebrow !text-[#f0c272]">Akses & keselamatan</p><h2 class="section-title mt-4 max-w-4xl">Cuplikan jam bukan izin masuk atau penilaian keselamatan.</h2><div class="mt-10 grid gap-5 lg:grid-cols-3"><article class="rounded-3xl border border-white/20 p-7"><h3 class="text-xl font-bold">Konfirmasikan sebelum datang</h3><p class="mt-4 leading-8">Maps mencantumkan 24 jam setiap hari pada 19 Oktober 2026. Itu tidak memastikan akses malam, petugas, loket atau seluruh area tebing terbuka. Ikuti penutupan dan arahan setempat.</p></article><article class="rounded-3xl border border-white/20 p-7"><h3 class="text-xl font-bold">Hormati pembatas</h3><p class="mt-4 leading-8">Dinas Pariwisata melaporkan pemeriksaan papan peringatan pada 30 Agustus 2025. Tetap di area yang diizinkan; jangan melampaui pagar atau turun ke batu yang terkena ombak untuk foto.</p></article><article class="rounded-3xl border border-white/20 p-7"><h3 class="text-xl font-bold">Tidak mengejar gelombang</h3><p class="mt-4 leading-8">Jangan menyimpulkan laut aman dari foto atau sela ombak yang tenang. Periksa prakiraan resmi dan instruksi petugas. Tidak ada jadwal pasang, ketinggian ombak, izin masuk air atau kondisi malam yang dijamin di sini.</p><a class="underline" href="https://maritim.bmkg.go.id/">Informasi maritim BMKG ↗</a></article></div></div></section>
<section id="biaya" class="py-20"><div class="section-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Biaya & cakupan</p><h2 class="section-title mt-4">Pisahkan retribusi kawasan dari tiket dan layanan lain.</h2></div><div class="prose-copy"><p><a href="https://protokol.klungkungkab.go.id/pemkab-klungkung-sosialisasi-perda-no-4-tahun-2026-pemungutan-retribusi-pariwisata-nusa-penida-efektif-berlaku-mulai-1-september-2026/">Laporan resmi Klungkung 19 Agustus 2026</a> menyebut retribusi kawasan Nusa Lembongan–Nusa Ceningan untuk <strong>wisatawan mancanegara</strong>: Rp25.000 per dewasa dan Rp15.000 per anak usia 4–13 tahun. Laporan menyatakan penyesuaian pemungutan mulai 1 September 2026 dan membedakan kawasan wisata dari daya tarik wisata (DTW).</p><p>Angka tersebut adalah konteks kebijakan kawasan, bukan konfirmasi tiket tunggal Devil’s Tear, biaya untuk semua kewarganegaraan, atau paket yang mencakup semua destinasi. Jangan menganggap kunjungan gratis atau satu pembayaran mencakup semua layanan.</p><p>Sebelum membayar, tanyakan kategori pengunjung, cakupan, masa berlaku, bukti pembayaran, metode bayar dan biaya tambahan seperti parkir atau transportasi. Panduan ini tidak menjual tiket.</p></div></div></section>
<section id="transportasi" class="bg-[#f3ead8] py-20"><div class="section-shell"><p class="eyebrow">Persiapan perjalanan</p><h2 class="section-title mt-4 max-w-4xl">Konfirmasikan setiap sambungan ke Nusa Lembongan.</h2><div class="mt-10 grid gap-5 lg:grid-cols-3"><article class="card p-7"><h3 class="text-xl font-bold">Ke pelabuhan</h3><p class="mt-4 leading-8">Tanyakan kepada penyedia perjalanan Anda pelabuhan yang benar, titik jemput, biaya serta waktu cadangan. Tidak ada rute bus, zona jemput bandara, atau durasi darat tertentu yang dipastikan di sini.</p></article><article class="card p-7"><h3 class="text-xl font-bold">Penyeberangan</h3><p class="mt-4 leading-8">Konfirmasikan jadwal, pelabuhan tujuan di Lembongan, bagasi, akses naik turun, pembatalan dan perjalanan pulang kepada operator. Jangan menganggap kapal selalu berangkat atau jadwal lama masih berlaku.</p></article><article class="card p-7"><h3 class="text-xl font-bold">Sambungan akhir</h3><p class="mt-4 leading-8">Konfirmasikan kendaraan, titik turun legal dan jalur akhir yang dapat digunakan. Pin bukan jaminan jalan kaki tersambung, parkir tersedia atau jalur sesuai kursi roda. Tidak ada durasi transfer tetap yang dijanjikan.</p></article></div></div></section>
<section class="py-20"><div class="section-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Fasilitas & aksesibilitas</p><h2 class="section-title mt-4">Rencana lama tidak memastikan fasilitas hari ini.</h2></div><div class="prose-copy"><p>Arsip Klungkung membahas rencana parkir, jalur, toilet dan ruang kuliner. Itu merupakan catatan perencanaan, bukan bukti bahwa semuanya telah selesai atau dapat digunakan sekarang.</p><p>Konfirmasikan toilet, parkir, tarif, akses kendaraan dan kondisi jalur sebelum tiba. Untuk makanan, air minum, ATM, bahan bakar, pengisian kendaraan atau penginapan, periksa penyedia dan jam layanan secara terpisah; tidak ada fasilitas tersebut yang dijamin di lokasi.</p><p>Jangan menganggap seluruh area tebing dapat diakses tanpa hambatan. Tanyakan kebutuhan mobilitas dan pendampingan sebelum perjalanan, lalu ikuti kondisi serta petunjuk di lokasi.</p></div></div></section>
<section class="bg-[#e1eee9] py-20"><div class="section-shell"><p class="eyebrow">Tujuan terpisah</p><h2 class="section-title mt-4">Tambahan perjalanan perlu pemeriksaan sendiri.</h2><p class="mt-6 max-w-3xl leading-8">Dream Beach, mangrove dan Tanjung Sangiang tercantum sebagai destinasi tersendiri dalam laporan pemeriksaan papan peringatan 2025. Penyebutan itu bukan verifikasi alamat, jalur penghubung, layanan atau akses saat ini. Periksa setiap tujuan secara terpisah; jangan menganggap pantai cocok untuk berenang atau ada tiket gabungan.</p></div></section>
<section id="peta" class="py-20"><div class="section-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">Lokasi pada peta</p><h2 class="section-title mt-4">Nusa Lembongan, Klungkung, Bali.</h2><p class="mt-6 leading-8">Google Maps 19 Oktober 2026 mencantumkan Nusa Lembongan, Jungutbatu, Kecamatan Nusa Penida, Klungkung, Bali 80771. Pin: -8.690565, 115.4302884. Gunakan sebagai orientasi; konfirmasikan akses akhir dan ikuti rambu.</p><a href={mapLink} class="mt-6 inline-flex rounded-full bg-[#146b68] px-6 py-3 font-bold text-white" target="_blank" rel="noreferrer">Buka Google Maps ↗</a></div><iframe title="Peta lokasi Devil’s Tear Nusa Lembongan" src="https://maps.google.com/maps?q=-8.690565,115.4302884&amp;z=16&amp;output=embed" width="600" height="480" style="border:0;width:100%;" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section id="faq" class="bg-[#f3ead8] py-20"><div class="section-shell grid gap-10 lg:grid-cols-[.65fr_1.35fr]"><div><p class="eyebrow">Tanya jawab</p><h2 class="section-title mt-4">Sebelum berangkat</h2></div><div class="space-y-4">{faqs.map(({q,a}) => <details class="card p-6"><summary class="cursor-pointer font-bold">{q}</summary><p class="mt-4 leading-8">{a}</p></details>)}</div></div></section>
<section id="sumber" class="py-20"><div class="section-shell"><p class="eyebrow">Sumber & tanggal</p><h2 class="section-title mt-4">Baca konteks dan batas sumbernya.</h2><div class="prose-copy mt-8"><p><a href="https://protokol.klungkungkab.go.id/pemkab-klungkung-sosialisasi-perda-no-4-tahun-2026-pemungutan-retribusi-pariwisata-nusa-penida-efektif-berlaku-mulai-1-september-2026/">Pemerintah Klungkung, 19 Agustus 2026: kebijakan retribusi kawasan</a> — perhatikan kategori wisatawan mancanegara serta pemungutan kawasan/DTW.</p><p><a href="https://dispar.klungkungkab.go.id/dinas-pariwisata-lakukan-pengecekan-papan-peringatan-di-sejumlah-dtw-di-nusa-lembongan/">Dinas Pariwisata, 2 September 2025: pemeriksaan papan peringatan 30 Agustus 2025</a> — catatan kegiatan, bukan penilaian kondisi laut saat ini.</p><p><a href="https://klungkungkab.go.id/berita/detail/devil-tears-mulai-dirilik-banyak-investor">Arsip Pemkab Klungkung: Pantai Batu Belek dan rencana fasilitas</a> — bukan konfirmasi fasilitas telah selesai atau beroperasi.</p><p><a href={mapLink}>Google Maps, diperiksa 19 Oktober 2026</a> — lokasi, 4,6 dari 7.267 ulasan publik dan cantuman 24 jam. Bukan situs atau pernyataan pengelola.</p><p>Kredit, tautan sumber dan lisensi setiap foto tercantum di dekat gambar. Foto arsip tidak memastikan ombak, akses atau fasilitas sekarang.</p></div></div></section>
</main><SiteFooter /><script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script></BaseLayout>
